{
  "name": "@gizmodata/gizmosql-mcp",
  "version": "0.1.0",
  "description": "Model Context Protocol (MCP) server and Claude Desktop extension for GizmoSQL",
  "author": "GizmoData LLC",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/server.js",
  "types": "./dist/server.d.ts",
  "bin": {
    "gizmosql-mcp": "./dist/cli.js"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gizmodata/gizmosql-mcp.git"
  },
  "homepage": "https://github.com/gizmodata/gizmosql-mcp#readme",
  "bugs": {
    "url": "https://github.com/gizmodata/gizmosql-mcp/issues"
  },
  "keywords": [
    "gizmosql",
    "gizmodata",
    "mcp",
    "model-context-protocol",
    "claude",
    "arrow",
    "flightsql",
    "duckdb",
    "sql"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "build": "npm run clean && tsc -p tsconfig.json",
    "typecheck": "npm run build && tsc -p tsconfig.test.json --noEmit",
    "lint": "eslint src test scripts --fix",
    "lint:ci": "eslint src test scripts",
    "test": "npm run build && node --test \"test/unit/**/*.test.ts\"",
    "test:integration": "npm run build && node --test \"test/integration/**/*.test.ts\"",
    "build:mcpb": "bash scripts/build-mcpb.sh",
    "prepublishOnly": "npm run typecheck && npm run lint:ci && npm test"
  },
  "dependencies": {
    "@gizmodata/gizmosql-client": "^2.2.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "apache-arrow": "^21.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@anthropic-ai/mcpb": "^2.1.2",
    "@eslint/js": "^9.0.0",
    "@types/node": "^24.0.0",
    "eslint": "^9.0.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0"
  },
  "allowScripts": {
    "@gizmodata/gizmosql-client@2.2.0": true
  }
}
